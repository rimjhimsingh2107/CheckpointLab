          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#1baf7a"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 0
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Recoveries",
      "description": "Completed crash-detect-restore-resume cycles.",
      "datasource": {
        "type": "prometheus",
        "uid": "checkpointlab-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "checkpointlab-prom"
          },
          "editorMode": "code",
          "expr": "max(checkpointlab_recoveries_total{ckpt_job=~\"$job\"})",
          "legendFormat": "",
