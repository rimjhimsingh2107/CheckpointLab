          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#eda100"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 0
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Throughput over time",
      "description": "TWO different things, plotted together on purpose. 'reported' is the exporter's gauge: a rolling mean of the last 20 logged step durations. It degrades gently across a recovery rather than collapsing, because a dead worker stops APPENDING to the log -- it does not write zeros -- so the mean just goes stale. 'observed' is rate() over the step counter, which does fall to zero while no steps are completing, and whose trough width is the recovery cost. Read the gauge for 'how fast is a step', the rate for 'is work happening at all'.",
      "datasource": {
        "type": "prometheus",
        "uid": "checkpointlab-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "checkpointlab-prom"
          },
          "editorMode": "code",
          "expr": "checkpointlab_throughput_steps_per_second{ckpt_job=~\"$job\"}",
          "legendFormat": "{{ckpt_job}} reported (rolling mean)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "checkpointlab-prom"
          },
          "editorMode": "code",
          "expr": "rate(checkpointlab_steps_completed_total{ckpt_job=~\"$job\"}[30s])",
          "legendFormat": "{{ckpt_job}} observed (rate)",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Checkpoint interval over time",
      "description": "Interval in effect (steps, stepped) against the scheduler's target T* = sqrt(2dM) in seconds. Phase 6 found these can disagree, which is why both are plotted.",
      "datasource": {
        "type": "prometheus",
        "uid": "checkpointlab-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "checkpointlab-prom"
          },
          "editorMode": "code",
          "expr": "checkpointlab_checkpoint_interval_steps{ckpt_job=~\"$job\"}",
          "legendFormat": "{{ckpt_job}} interval (steps)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "checkpointlab-prom"
          },
          "editorMode": "code",
          "expr": "checkpointlab_scheduler_optimal_interval_seconds{ckpt_job=~\"$job\"}",
          "legendFormat": "{{ckpt_job}} T* (seconds)",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": false,
            "lineInterpolation": "stepAfter"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Recovery duration, split by phase",
      "description": "~97% is reach_first_step: a fresh interpreter importing torch, rebuilding the model, loading the checkpoint. A dashboard showing only the total would send you optimising the controller instead.",
      "datasource": {
        "type": "prometheus",
        "uid": "checkpointlab-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "checkpointlab-prom"
          },
          "editorMode": "code",
          "expr": "checkpointlab_recovery_phase_seconds{ckpt_job=~\"$job\"}",
          "legendFormat": "{{phase}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "terminate_workers"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a78d6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "select_checkpoint"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eb6834"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "relaunch_workers"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1baf7a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "reach_first_step"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#eda100"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      }
    },
