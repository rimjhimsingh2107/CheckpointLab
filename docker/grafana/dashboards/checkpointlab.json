{
  "uid": "checkpointlab",
  "title": "CheckpointLab \u2014 training, failures, recovery",
  "description": "Live view of the CheckpointLab testbed. Metrics come from metrics/prometheus.py, which re-reads each job's JSONL logs on scrape because the training workers are killed on purpose and cannot host a scrape target themselves.",
  "tags": [
    "checkpointlab",
    "phase7"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "checkpointlab-prom"
        },
        "query": {
          "query": "label_values(checkpointlab_last_step, ckpt_job)",
          "refId": "job-values"
        },
        "definition": "label_values(checkpointlab_last_step, ckpt_job)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active failures",
      "description": "Failures detected but not yet recovered. Non-zero only DURING an incident, which is what makes it the alertable signal.",
      "datasource": {
        "type": "prometheus",
        "uid": "checkpointlab-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "checkpointlab-prom"
          },
          "editorMode": "code",
          "expr": "max(checkpointlab_active_failures{ckpt_job=~\"$job\"})",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "fixedColor": "#2a78d6"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#1baf7a",
                "value": null
              },
              {
                "color": "#e34948",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Throughput",
      "description": "Steps/sec over the last 20 steps.",
      "datasource": {
        "type": "prometheus",
        "uid": "checkpointlab-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "checkpointlab-prom"
          },
          "editorMode": "code",
          "expr": "max(checkpointlab_throughput_steps_per_second{ckpt_job=~\"$job\"})",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Last recovery",
      "description": "Most recent failure-detected to training-resumed duration.",
      "datasource": {
        "type": "prometheus",
        "uid": "checkpointlab-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "checkpointlab-prom"
          },
          "editorMode": "code",
          "expr": "max(checkpointlab_recovery_duration_seconds{ckpt_job=~\"$job\"})",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#eb6834"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 0
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Checkpoint interval",
      "description": "Interval currently in effect, in steps (not the computed one).",
      "datasource": {
        "type": "prometheus",
        "uid": "checkpointlab-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "checkpointlab-prom"
          },
          "editorMode": "code",
          "expr": "max(checkpointlab_checkpoint_interval_steps{ckpt_job=~\"$job\"})",
          "legendFormat": "",
